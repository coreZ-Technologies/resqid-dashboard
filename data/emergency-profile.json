{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resqid/emergency-profile",
  "title": "EmergencyProfile",
  "description": "One-to-one with Student. Shown on QR scan. Visibility controlled by showX fields. Maps to emergency_profiles table.",
  "type": "object",
  "required": ["id", "studentId", "schoolId"],
  "properties": {
    "id": { "type": "string" },
    "studentId": { "type": "string", "description": "FK → students.id — @unique" },
    "schoolId": { "type": "string", "description": "FK → schools.id" },
    "bloodGroup": {
      "type": "string",
      "enum": ["A_POSITIVE", "A_NEGATIVE", "B_POSITIVE", "B_NEGATIVE", "O_POSITIVE", "O_NEGATIVE", "AB_POSITIVE", "AB_NEGATIVE", "UNKNOWN"],
      "description": "Prisma maps: A_POSITIVE → 'A+' etc. Default: UNKNOWN",
      "default": "UNKNOWN"
    },
    "allergies": { "type": "array", "items": { "type": "string" }, "default": [] },
    "medications": { "type": "array", "items": { "type": "string" }, "default": [] },
    "conditions": { "type": "array", "items": { "type": "string" }, "default": [] },
    "medicalNotes": { "type": ["string", "null"] },
    "doctorName": { "type": ["string", "null"] },
    "doctorPhone": { "type": ["string", "null"] },
    "doctorSpecialization": { "type": ["string", "null"] },
    "doctorClinic": { "type": ["string", "null"] },
    "doctorAddress": { "type": ["string", "null"] },
    "hospitalName": { "type": ["string", "null"] },
    "hospitalPhone": { "type": ["string", "null"] },
    "hospitalAddress": { "type": ["string", "null"] },
    "insuranceProvider": { "type": ["string", "null"] },
    "insurancePolicyNumber": { "type": ["string", "null"] },
    "insuranceValidUntil": { "type": ["string", "null"], "format": "date-time" },
    "emergencyInstructions": { "type": ["string", "null"] },
    "specialNeeds": { "type": ["string", "null"] },
    "showBloodGroup": { "type": "boolean", "default": true },
    "showAllergies": { "type": "boolean", "default": true },
    "showMedications": { "type": "boolean", "default": true },
    "showConditions": { "type": "boolean", "default": true },
    "showContacts": { "type": "boolean", "default": true },
    "showDoctorInfo": { "type": "boolean", "default": true },
    "showInstructions": { "type": "boolean", "default": true },
    "showInsurance": { "type": "boolean", "default": false },
    "showSpecialNeeds": { "type": "boolean", "default": true },
    "isComplete": { "type": "boolean", "default": false },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "lastVerifiedAt": { "type": ["string", "null"], "format": "date-time" },
    "verifiedBy": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "contacts": {
      "type": "array",
      "items": { "$ref": "#/definitions/EmergencyContact" }
    }
  },
  "definitions": {
    "EmergencyContact": {
      "$id": "resqid/emergency-contact",
      "title": "EmergencyContact",
      "description": "Contact shown on QR scan. Ordered by priority (0 = highest). Maps to emergency_contacts table.",
      "type": "object",
      "required": ["id", "profileId", "name", "phone", "relation"],
      "properties": {
        "id": { "type": "string" },
        "profileId": { "type": "string", "description": "FK → emergency_profiles.id" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "alternatePhone": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "relation": {
          "type": "string",
          "enum": ["FATHER", "MOTHER", "GUARDIAN", "GRANDPARENT", "SIBLING", "RELATIVE", "FAMILY_DOCTOR", "NEIGHBOR", "OTHER"]
        },
        "address": { "type": ["string", "null"] },
        "photoUrl": { "type": ["string", "null"] },
        "isPrimary": { "type": "boolean", "default": false },
        "priority": { "type": "integer", "default": 0, "description": "0 = call first" },
        "isLegalGuardian": { "type": "boolean", "default": false },
        "isActive": { "type": "boolean", "default": true },
        "callEnabled": { "type": "boolean", "default": true },
        "whatsappEnabled": { "type": "boolean", "default": false },
        "smsEnabled": { "type": "boolean", "default": true },
        "available24x7": { "type": "boolean", "default": false },
        "availableFrom": { "type": ["string", "null"], "examples": ["09:00"] },
        "availableTo": { "type": ["string", "null"], "examples": ["18:00"] },
        "timezone": { "type": ["string", "null"] },
        "canPickup": { "type": "boolean", "default": false },
        "pickupPassword": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "x-prisma-model": "EmergencyProfile",
  "x-table": "emergency_profiles",
  "x-module": "emergency",
  "x-qr-scan-note": "When QR is scanned, only fields where showX=true are exposed. Controlled by EMERGENCY_RESPONDER role."
}
