{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resqid/plan",
  "title": "Plan",
  "description": "Subscription plan definition. Prices live here; module mapping lives in plans.js. Maps to plans table.",
  "type": "object",
  "required": ["id", "label", "pricePerStudent", "modules", "isActive"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Matches PLAN_IDS in plans.js",
      "enum": [
        "module_emergency",
        "module_attendance",
        "module_timetable",
        "module_parent_communication",
        "bundle_safety",
        "bundle_ops",
        "bundle_connect",
        "resqid_complete"
      ]
    },
    "label": { "type": "string", "examples": ["Emergency ID Module", "Safety Bundle", "RESQID Complete"] },
    "description": { "type": ["string", "null"] },
    "pricePerStudent": { "type": "integer", "description": "Price in paise (INR). Divide by 100 for rupees." },
    "currency": { "type": "string", "default": "INR" },
    "billingCycle": { "type": "string", "default": "MONTHLY", "enum": ["MONTHLY", "YEARLY", "QUARTERLY"] },
    "modules": {
      "type": "array",
      "items": { "type": "string", "enum": ["emergency", "attendance", "timetable", "parent_communication"] },
      "description": "Modules unlocked. Source of truth is PLAN_MODULES in plans.js."
    },
    "maxStudents": { "type": ["integer", "null"], "description": "Null = unlimited within plan tier" },
    "maxTeachers": { "type": ["integer", "null"] },
    "maxSchools": { "type": "integer", "default": 1 },
    "trialDays": { "type": "integer", "default": 14 },
    "isTrialAvailable": { "type": "boolean", "default": true },
    "isActive": { "type": "boolean", "default": true },
    "isDefault": { "type": "boolean", "default": false },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "x-prisma-model": "Plan",
  "x-table": "plans",
  "x-note": "Device limits and student limits from plans.js constants override DB values in middleware"
}
