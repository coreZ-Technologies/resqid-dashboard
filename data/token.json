{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resqid/token",
  "title": "Token",
  "description": "Physical/digital token assigned to a student — QR code, RFID card, or NFC tag. Maps to tokens table.",
  "type": "object",
  "required": ["id", "schoolId", "type", "status"],
  "properties": {
    "id": { "type": "string", "description": "cuid() — primary key" },
    "studentId": { "type": ["string", "null"], "description": "FK → students.id (null if unassigned)" },
    "schoolId": { "type": "string", "description": "FK → schools.id" },
    "type": {
      "type": "string",
      "enum": ["RFID", "QR", "NFC", "COMBO"],
      "description": "COMBO = QR + RFID on same card"
    },
    "rfidUid": { "type": ["string", "null"], "description": "Unique RFID card UID — unique constraint in DB" },
    "qrCode": { "type": ["string", "null"], "description": "Human-readable QR identifier e.g. RESQID-STU-2024-001234" },
    "qrCodeHash": { "type": ["string", "null"], "description": "Hashed QR for fast lookup" },
    "scanCode": { "type": ["string", "null"], "description": "AES-SIV encrypted scan payload — used in QR URL" },
    "scanCodeHash": { "type": ["string", "null"], "description": "Hash of scanCode for lookup" },
    "scanCodeEncryptedAt": { "type": ["string", "null"], "format": "date-time" },
    "qrGenerated": { "type": "boolean", "default": false },
    "qrFormat": { "type": ["string", "null"], "enum": ["PNG", "SVG", "PDF", null] },
    "qrWidthPx": { "type": ["integer", "null"] },
    "qrHeightPx": { "type": ["integer", "null"] },
    "qrFileSizeKb": { "type": ["number", "null"] },
    "qrAssetUrl": { "type": ["string", "null"], "format": "uri" },
    "qrGeneratedAt": { "type": ["string", "null"], "format": "date-time" },
    "qrRegeneratedAt": { "type": ["string", "null"], "format": "date-time" },
    "qrRegenerationCount": { "type": "integer", "default": 0 },
    "qrForegroundColor": { "type": ["string", "null"], "default": "#000000" },
    "qrBackgroundColor": { "type": ["string", "null"], "default": "#FFFFFF" },
    "qrLogoUrl": { "type": ["string", "null"] },
    "qrErrorCorrection": { "type": ["string", "null"], "enum": ["L", "M", "Q", "H", null], "default": "M" },
    "status": {
      "type": "string",
      "enum": ["UNREGISTERED", "ISSUED", "ACTIVE", "INACTIVE", "REVOKED", "LOST", "EXPIRED"],
      "description": "Valid transitions defined in status.js VALID_TRANSITIONS"
    },
    "issuedAt": { "type": ["string", "null"], "format": "date-time" },
    "activatedAt": { "type": ["string", "null"], "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "revokedAt": { "type": ["string", "null"], "format": "date-time" },
    "revokedBy": { "type": ["string", "null"], "description": "SchoolUser or SuperAdmin ID" },
    "revokeReason": { "type": ["string", "null"] },
    "label": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] },
    "batchId": { "type": ["string", "null"], "description": "Used to group bulk-generated tokens" },
    "metadata": { "type": ["object", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "x-prisma-model": "Token",
  "x-table": "tokens",
  "x-sensitive-fields": ["scanCode", "scanCodeHash", "qrCodeHash"],
  "x-frontend-safe": ["id", "studentId", "schoolId", "type", "rfidUid", "qrCode", "qrAssetUrl", "qrGenerated", "status", "issuedAt", "activatedAt", "expiresAt", "label"],
  "x-status-machine": "UNREGISTERED → ISSUED → ACTIVE ↔ INACTIVE | LOST | REVOKED | EXPIRED"
}
