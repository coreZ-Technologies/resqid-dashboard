{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resqid/notification",
  "title": "Notification + Preferences",
  "description": "Multi-channel notification delivery. Maps to notifications + notification_preferences tables.",

  "definitions": {

    "Notification": {
      "title": "Notification",
      "type": "object",
      "required": ["id", "title", "body", "category", "channel", "status"],
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "schoolUserId": { "type": ["string", "null"] },
        "studentId": { "type": ["string", "null"] },
        "schoolId": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "shortBody": { "type": ["string", "null"], "description": "For SMS/push preview" },
        "category": {
          "type": "string",
          "enum": ["ATTENDANCE", "FEE", "EXAM", "EVENT", "EMERGENCY", "ANNOUNCEMENT", "SCAN_ALERT", "HOMEWORK", "REPORT_CARD", "SYSTEM", "OTHER"]
        },
        "priority": {
          "type": "string",
          "enum": ["LOW", "NORMAL", "HIGH", "URGENT"],
          "default": "NORMAL"
        },
        "actionUrl": { "type": ["string", "null"] },
        "actionLabel": { "type": ["string", "null"] },
        "imageUrl": { "type": ["string", "null"] },
        "data": { "type": ["object", "null"] },
        "referenceId": { "type": ["string", "null"] },
        "referenceType": { "type": ["string", "null"] },
        "channel": {
          "type": "string",
          "enum": ["SMS", "EMAIL", "PUSH", "IN_APP", "WHATSAPP"]
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "QUEUED", "PROCESSING", "SENT", "DELIVERED", "READ", "FAILED", "CANCELLED", "BOUNCED", "SPAM"],
          "default": "PENDING"
        },
        "failReason": { "type": ["string", "null"] },
        "retryCount": { "type": "integer", "default": 0 },
        "maxRetries": { "type": "integer", "default": 3 },
        "externalId": { "type": ["string", "null"] },
        "providerResponse": { "type": ["object", "null"] },
        "groupId": { "type": ["string", "null"] },
        "isRead": { "type": "boolean", "default": false },
        "isArchived": { "type": "boolean", "default": false },
        "scheduledFor": { "type": ["string", "null"], "format": "date-time" },
        "sentAt": { "type": ["string", "null"], "format": "date-time" },
        "deliveredAt": { "type": ["string", "null"], "format": "date-time" },
        "readAt": { "type": ["string", "null"], "format": "date-time" },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },

    "NotificationPreference": {
      "title": "NotificationPreference",
      "description": "Per-user notification settings — one per parent or school user.",
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "schoolUserId": { "type": ["string", "null"] },
        "smsEnabled": { "type": "boolean", "default": true },
        "emailEnabled": { "type": "boolean", "default": false },
        "pushEnabled": { "type": "boolean", "default": true },
        "inAppEnabled": { "type": "boolean", "default": true },
        "whatsappEnabled": { "type": "boolean", "default": false },
        "onScan": { "type": "boolean", "default": true },
        "onAttendance": { "type": "boolean", "default": true },
        "onAbsent": { "type": "boolean", "default": true },
        "onLate": { "type": "boolean", "default": true },
        "onFee": { "type": "boolean", "default": true },
        "onExam": { "type": "boolean", "default": true },
        "onEvent": { "type": "boolean", "default": true },
        "onEmergency": { "type": "boolean", "default": true },
        "onAnnouncement": { "type": "boolean", "default": true },
        "onHomework": { "type": "boolean", "default": false },
        "onReportCard": { "type": "boolean", "default": true },
        "quietHoursEnabled": { "type": "boolean", "default": false },
        "quietHoursStart": { "type": ["string", "null"], "examples": ["22:00"] },
        "quietHoursEnd": { "type": ["string", "null"], "examples": ["07:00"] },
        "quietHoursTimezone": { "type": ["string", "null"] },
        "language": { "type": "string", "default": "en" },
        "studentOverrides": { "type": ["object", "null"], "description": "Per-student preference overrides" },
        "maxPerHour": { "type": ["integer", "null"] },
        "digestMode": { "type": "boolean", "default": false }
      }
    }
  }
}
