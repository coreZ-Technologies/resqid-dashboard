{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resqid/audit-log",
  "title": "AuditLog",
  "description": "Central audit log for all business-level actions across the platform. Maps to audit_logs table.",
  "type": "object",
  "required": ["id", "action", "severity", "createdAt"],
  "properties": {
    "id": { "type": "string" },
    "action": {
      "type": "string",
      "examples": ["TIMETABLE_GENERATED", "TEACHER_SUBSTITUTED", "CRISIS_RESOLVED", "STUDENT_CREATED", "EMERGENCY_PROFILE_UPDATED"]
    },
    "severity": {
      "type": "string",
      "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"],
      "default": "INFO"
    },
    "description": { "type": ["string", "null"] },
    "actorId": { "type": ["string", "null"] },
    "actorType": {
      "type": ["string", "null"],
      "enum": ["SUPER_ADMIN", "SCHOOL_ADMIN", "TEACHER", "PARENT", "SYSTEM", "API", "ANONYMOUS", null]
    },
    "actorName": { "type": ["string", "null"], "description": "Denormalized for display" },
    "entity": {
      "type": ["string", "null"],
      "enum": ["SCHOOL", "USER", "TEACHER", "STUDENT", "PARENT", "TIMETABLE", "TIMETABLE_TEMPLATE", "CLASS_GROUP", "SUBJECT", "ROOM", "SUBSTITUTION", "CRISIS_EVENT", "WELLNESS", "CONSTRAINT_PRESET", "BULK_UPLOAD", "ATTENDANCE", "SCAN", "NOTIFICATION", "FEATURE_FLAG", "SUBSCRIPTION", "OTHER", null]
    },
    "entityId": { "type": ["string", "null"] },
    "entityLabel": { "type": ["string", "null"] },
    "oldValue": { "type": ["object", "null"] },
    "newValue": { "type": ["object", "null"] },
    "changes": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "field": { "type": "string" },
          "oldValue": {},
          "newValue": {}
        }
      }
    },
    "schoolId": { "type": ["string", "null"] },
    "ipAddress": { "type": ["string", "null"] },
    "userAgent": { "type": ["string", "null"] },
    "device": { "type": ["string", "null"] },
    "requestId": { "type": ["string", "null"] },
    "sessionId": { "type": ["string", "null"] },
    "metadata": { "type": ["object", "null"] },
    "isSensitive": { "type": "boolean", "default": false },
    "retentionUntil": { "type": ["string", "null"], "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "x-prisma-model": "AuditLog",
  "x-table": "audit_logs",
  "x-archive-table": "audit_logs_archive",
  "x-access": "SUPER_ADMIN only (audit_log:read permission)"
}
