{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resqid/communication",
  "title": "Communication Module Schemas",
  "description": "Announcements, direct messages, templates, campaigns. Module: parent_communication.",
  "x-module": "parent_communication",

  "definitions": {

    "Announcement": {
      "title": "Announcement",
      "description": "School-wide or targeted announcement. Maps to announcements table.",
      "type": "object",
      "required": ["id", "schoolId", "authorId", "title", "body", "priority", "target"],
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "authorId": { "type": "string", "description": "FK → school_users.id" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "imageUrl": { "type": ["string", "null"], "format": "uri" },
        "attachments": { "type": "array", "items": { "type": "string" }, "default": [] },
        "priority": {
          "type": "string",
          "enum": ["LOW", "NORMAL", "HIGH", "URGENT"],
          "default": "NORMAL"
        },
        "target": {
          "type": "string",
          "enum": ["ALL", "GRADE", "SECTION", "STUDENT", "PARENT", "STAFF", "CUSTOM"],
          "default": "ALL"
        },
        "targetGrades": { "type": "array", "items": { "type": "string" }, "default": [] },
        "targetSections": { "type": "array", "items": { "type": "string" }, "default": [] },
        "targetClassIds": { "type": "array", "items": { "type": "string" }, "default": [] },
        "targetStudentIds": { "type": "array", "items": { "type": "string" }, "default": [] },
        "isPublic": { "type": "boolean", "default": false },
        "publishedAt": { "type": ["string", "null"], "format": "date-time" },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "isArchived": { "type": "boolean", "default": false },
        "totalRecipients": { "type": "integer", "default": 0 },
        "deliveredCount": { "type": "integer", "default": 0 },
        "readCount": { "type": "integer", "default": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },

    "Message": {
      "title": "Message",
      "description": "Direct message between school and parent. Threaded via threadId. Maps to messages table.",
      "type": "object",
      "required": ["id", "schoolId", "direction", "type", "body"],
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "threadId": { "type": ["string", "null"] },
        "direction": {
          "type": "string",
          "enum": ["SCHOOL_TO_PARENT", "PARENT_TO_SCHOOL", "SYSTEM"]
        },
        "type": {
          "type": "string",
          "enum": ["GENERAL", "ATTENDANCE", "FEE_REMINDER", "EVENT_INVITATION", "REPORT_CARD", "EMERGENCY", "ABSENT_NOTIFICATION", "HOMEWORK", "EXAM_SCHEDULE", "PAYMENT_RECEIPT", "TIMETABLE_CHANGE", "SUBSTITUTION_ALERT", "CRISIS_ALERT"]
        },
        "senderId": { "type": ["string", "null"], "description": "FK → school_users.id" },
        "parentId": { "type": ["string", "null"], "description": "FK → parent_users.id" },
        "studentId": { "type": ["string", "null"] },
        "subject": { "type": ["string", "null"] },
        "body": { "type": "string" },
        "attachments": { "type": "array", "items": { "type": "string" }, "default": [] },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "SCHEDULED", "SENT", "DELIVERED", "READ", "REPLIED", "FAILED", "CANCELLED"],
          "default": "SENT"
        },
        "isRead": { "type": "boolean", "default": false },
        "readAt": { "type": ["string", "null"], "format": "date-time" },
        "repliedTo": { "type": ["string", "null"] },
        "channels": {
          "type": "array",
          "items": { "type": "string", "enum": ["SMS", "EMAIL", "PUSH", "IN_APP", "WHATSAPP"] }
        },
        "metadata": { "type": ["object", "null"] },
        "timetableId": { "type": ["string", "null"] },
        "crisisId": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },

    "MessageTemplate": {
      "title": "MessageTemplate",
      "type": "object",
      "required": ["id", "schoolId", "name", "type", "subject", "body", "createdById"],
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "name": { "type": "string", "examples": ["Absent Notification", "Fee Reminder"] },
        "type": { "type": "string" },
        "subject": { "type": "string" },
        "body": { "type": "string", "description": "Supports variables: {{studentName}}, {{date}}, {{amount}}" },
        "variables": { "type": "array", "items": { "type": "string" }, "examples": [["studentName", "date", "amount"]] },
        "createdById": { "type": "string" },
        "isActive": { "type": "boolean", "default": true },
        "isDefault": { "type": "boolean", "default": false },
        "usageCount": { "type": "integer", "default": 0 },
        "lastUsedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
